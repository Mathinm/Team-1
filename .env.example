POSTGRES_USER=pms
POSTGRES_PASSWORD=password
POSTGRES_DB=pms
DATABASE_URL=postgresql://pms:password@db:5432/pms
# Signs login sessions (HS256). Use a long random string outside local development.
JWT_SECRET=change-me-dev-only-use-at-least-32-characters
# First Admin, created only when there are no users yet (SEC-1, #3)
ADMIN_PASSWORD=admin123
# Also create manager1/manager123, staff1/staff123, cashier1/cashier123 (dev and demo only)
SEED_DEMO_USERS=true
# Lock an account after this many wrong passwords in a row 
MAX_FAILED_LOGINS=5
# End a session after this many minutes without any request 
IDLE_TIMEOUT_MINUTES=30
# "Expires today" is judged on this timezone's calendar day.
STORE_TIMEZONE=Asia/Kolkata
