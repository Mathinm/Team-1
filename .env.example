POSTGRES_USER=pms
POSTGRES_PASSWORD=password
POSTGRES_DB=pms
DATABASE_URL=postgresql://pms:password@db:5432/pms
# Signs login sessions (HS256). Use a long random string outside local development.
JWT_SECRET=change-me-dev-only-use-at-least-32-characters
# First Admin, created only when there are no users yet (SEC-1, #3)
ADMIN_PASSWORD=admin123
# Also create manager1/manager123, staff1/staff123, cashier1/cashier123 (dev and demo only)
SEED_DEMO_USERS=true
# Lock an account after this many wrong passwords in a row (SEC-3)
MAX_FAILED_LOGINS=5
# End a session after this many minutes without any request (SEC-3)
IDLE_TIMEOUT_MINUTES=30
# Manager and Admin also need a 6-digit code sent to their email (NFR-10)
REQUIRE_2FA=true
OTP_EXPIRE_MINUTES=10
# Password reset links (SEC-5) expire after this many minutes and point to FRONTEND_URL
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173
# Encrypts employee names and emails in the database (NFR-11). Make one: python -m app.crypto
# Empty = derived from JWT_SECRET (local only). Keep it out of git and away from DB backups.
DATA_ENCRYPTION_KEY=
# Email. Empty SMTP_HOST = emails (and login codes) are printed in the backend log instead.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASSWORD=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PMS <no-reply@example.com>
# "Expires today" is judged on this timezone's calendar day.
STORE_TIMEZONE=Asia/Kolkata
# Alerts and refrigeration (S2-4, S2-5). All optional; these are the defaults.
# SCHEDULER_ENABLED=true
# SCHEDULER_INTERVAL_SECONDS=10
# LOW_STOCK_CHECK_TIME=06:00
# DOOR_OPEN_LIMIT_MINUTES=5
# UNIT_TEMP_MIN_C=0
# UNIT_TEMP_MAX_C=8
