POSTGRES_USER=pms
POSTGRES_PASSWORD=password
POSTGRES_DB=pms
DATABASE_URL=postgresql://pms:password@db:5432/pms
# Signs login sessions (HS256). Use a long random string outside local development.
JWT_SECRET=change-me-dev-only
